# Telegram Bot Token (get from @BotFather)
TELEGRAM_BOT_TOKEN=

# Webhook secret — Render auto-passes this to Telegram
WEBHOOK_SECRET=

# Cloudinary — used to store forwarded files so they stream on the website
CLOUDINARY_URL=

# Public website base (where /camera and /dl links point)
PUBLIC_BASE_URL=https://azim.run.place

# Optional private channel to permanently back up forwarded files
BIN_CHANNEL=
# Numeric chat ID of the BIN channel (negative number) — needed for t.me deep-link
BIN_CHANNEL_ID=
# The bot's @username (no @) — needed for t.me deep-link "Get file in Telegram"
BOT_USERNAME=

# ── Secretary Mode (Instant Get link extraction) ──
# @username of a third-party link-generator bot. When a user clicks
# "Instant Get File" on the website, the bot forwards the movie to this
# bot and parses the download URL from its reply.
LINK_GENERATOR_BOT=

# Admin delivery of /camera photos: numeric Telegram ID (via /myid) or username
OWNER_CHAT_ID=
OWNER_USERNAME=Azimxyz

# How often the bot polls the website for new camera captures (seconds)
CAMERA_POLL_SECONDS=15

# Local database
DB_URL=